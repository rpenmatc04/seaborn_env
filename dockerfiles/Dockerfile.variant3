# Variant that skips optional extras and tooling
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app

RUN pip install --upgrade pip
# Explicitly install only stats extras, do not read pyproject for deps
RUN pip install \
    "numpy>=1.20,!=1.24.0" \
    "pandas>=1.2" \
    "matplotlib>=3.4,!=3.6.1" \
    "scipy>=1.7" \
    "statsmodels>=0.12"
RUN pip install --no-deps -e .

CMD ["pytest", "tests"]
