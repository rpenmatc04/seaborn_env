# Variant without cloned datasets or pandoc
FROM python:3.11-slim

ENV MPLBACKEND=Agg

RUN apt-get update && apt-get install -y --no-install-recommends build-essential git && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app

RUN pip install --upgrade pip
# Install only dev/test tooling explicitly; avoid reading pyproject for deps
RUN pip install \
    "pytest" \
    "pytest-cov" \
    "pytest-xdist" \
    "flake8" \
    "mypy"
RUN pip install --no-deps -e .

CMD ["bash", "-lc", "make test"]
